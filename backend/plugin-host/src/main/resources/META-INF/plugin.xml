
<idea-plugin>

    <id>com.devqa.DevQA</id>

    <name>DevQA</name>

    <vendor>DevQA</vendor>

    <description><![CDATA[
    DevQA is an IntelliJ IDEA plugin designed to help software engineering teams
    understand projects and identify potential quality issues before handing tasks over to QA.

    It detects the real project framework and primary language, then analyzes project structure, business context, change impact,
    testing scenarios, and software quality risks directly inside the IDE.
    ]]></description>

    <!-- Core Platform -->
    <depends>com.intellij.modules.platform</depends>
    <!--
        JCEF is provided by the IDE runtime on older supported builds. Its module alias
        is available from 2025.3.1, and it is a separate bundled plugin starting in 2026.2.
        Keep this dependency optional so older IDEs remain loadable while newer IDEs
        attach the JCEF classloader when the capability is present.
    -->
    <depends optional="true" config-file="devqa-jcef.xml">com.intellij.modules.jcef</depends>

    <!-- Required Languages -->
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">

        <supportsKotlinPluginMode
                supportsK1="true"
                supportsK2="true"/>

    </extensions>

    <extensions defaultExtensionNs="com.intellij">

        <toolWindow
                id="DevQA"
                factoryClass="com.devqa.plugin.toolwindow.DevQAToolWindowFactory"
                icon="/icons/devqa.svg"/>

        <fileEditorProvider
                implementation="com.devqa.feature.projectbrain.presentation.DevQAAnalysisEditorProvider"/>

    </extensions>

</idea-plugin>
